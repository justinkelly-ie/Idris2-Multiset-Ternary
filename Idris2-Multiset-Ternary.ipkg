package Idris2-Multiset-Ternary
version = 0.1.0
authors = "Justin Kelly"
brief   = "Layer 2b Dependent Alphabet (F2 -> F3) and Narayana Polynomial Engine."

depends = base
        , Idris2-Multiset-Core
        , Idris2-Multiset-Binary

modules = Core.NarayAlphabet
        , Math.NarayanaPolynomial
        , Math.AlgebraOfBoole
        , Reflect.NarayElab
        , Linear.NarayState
        , Logic.TernaryLogic

sourcedir = "src"
